<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
        <property>
                <name>dfs.nameservices</name>
                <value>psons</value>
        </property>
        <property>
                <name>dfs.ha.namenodes.psons</name>
                <value>nn1,nn2</value>
        </property>
        <property>
                <name>dfs.namenode.rpc-address.psons.nn1</name>
                <value>${nn1_host}:8020</value>
        </property>
        <property>
                <name>dfs.namenode.http-address.psons.nn1</name>
                <value>${nn1_host}:50070</value>
        </property>
        <property>
                <name>dfs.namenode.rpc-address.psons.nn2</name>
                <value>${nn2_host}:8020</value>
        </property>
        <property>
                <name>dfs.namenode.http-address.psons.nn2</name>
                <value>${nn2_host}:50070</value>
        </property>
        <property>
                <name>dfs.namenode.servicerpc-address.psons.nn1</name>
                <value>${nn1_host}:8022</value>
        </property>
        <property>
                <name>dfs.namenode.servicerpc-address.psons.nn2</name>
                <value>${nn2_host}:8022</value>
        </property>
        <property>
                <name>dfs.namenode.shared.edits.dir</name>
                <value>qjournal://${jnode_hosts}/psons</value>
        </property>
        <property>
                <name>dfs.journalnode.edits.dir</name>
                <value>${data_dir}/journal</value>
        </property>
        <property>
                <name>dfs.ha.automatic-failover.enabled.psons</name>
                <value>true</value>
        </property>
        <property>
                <name>dfs.client.failover.proxy.provider.psons</name>
                <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
        </property>
        <property>
                <name>dfs.ha.fencing.methods</name>
                <value>sshfence</value>
        </property>
        <property>
                <name>dfs.ha.fencing.ssh.private-key-files</name>
                <value>${ssh_key_path}</value>
        </property>
        <property>
                <name>dfs.replication</name>
                <value>2</value>
        </property>
        <property>
                <name>dfs.permissions</name>
                <value>false</value>
        </property>
        <property>
                <name>dfs.namenode.name.dir</name>
                <value>file://${data_dir}/namenode</value>
        </property>
        <property>
                <name>dfs.datanode.data.dir</name>
                <value>file://${data_dir}/datanode</value>
        </property>
        <property>
                <name>dfs.webhdfs.enabled</name>
                <value>true</value>
        </property>
</configuration>
